# EditorConfig — https://editorconfig.org
# Ensures consistent formatting across all editors (VS Code, Sublime, etc.)

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.liquid]
indent_size = 2

[*.css]
indent_size = 2

[*.js]
indent_size = 2
